// Renovate (D76), run on a schedule by the renovate job in ci/renovate.yml.
//
// The rules keep the pins that the spec and the decisions fix: Manim 0.22.0,
// Typst 0.15.0, CPython 3.14.9 (3.13.17 as the fallback), uv 0.13.5, Rust
// 1.93.0, Node 24, Tauri 2.12.x, React 19 and Vite 8. Those change by hand,
// together with every copy and, where the spec names them, a spec revision.
// TinyTeX, Typst and the bundle's CPython and uv are pinned with their SHA-256s
// in packaging/versions.env, which no manager reads.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  // The hook revisions in .pre-commit-config.yaml, and the mypy and pytest pins
  // in the additional_dependencies of the mypy hooks, which Renovate reads
  // because those hooks declare language: python.
  "pre-commit": {
    enabled: true,
  },
  // uv.lock is rewritten by the uv release that [tool.uv] required-version
  // demands (UV_VERSION in packaging/versions.env).
  constraints: {
    uv: "0.13.5",
  },
  customManagers: [
    {
      description: "Versions in the CI files under a `# renovate:` comment: the Node release of the Windows jobs and the cargo-deny release.",
      customType: "regex",
      managerFilePatterns: ["/^ci/.+\\.yml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Z_]+: (?<currentValue>\\S+)",
      ],
    },
  ],
  packageRules: [
    {
      description: "Manim and Typst move only with a spec revision: a Manim bump also bumps generatorVersion, and the shell checks the Typst version.",
      matchPackageNames: ["manim", "typst"],
      enabled: false,
    },
    {
      description: "CPython, uv and Rust are pinned in packaging/versions.env, .python-version, pyproject.toml, rust-toolchain.toml, Cargo.toml and the CI images, and move in all of them at once.",
      matchPackageNames: ["python", "uv", "ghcr.io/astral-sh/uv", "rust"],
      enabled: false,
    },
    {
      description: "The rest of the render stack in [tool.uv] is the audited bundle's (D34). An update changes every installer, so it waits for approval on the dependency dashboard and needs a render lane run.",
      matchManagers: ["pep621"],
      matchDepTypes: ["!dependency-groups"],
      dependencyDashboardApproval: true,
    },
    {
      description: "Node 24 LTS (D37): desktop/.nvmrc, engines.node, the CI images and @types/node keep the major.",
      matchPackageNames: ["node", "@types/node"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      description: "The Linux image and the Windows jobs run the same Node release.",
      matchPackageNames: ["node"],
      groupName: "Node.js",
    },
    {
      description: "Tauri stays on 2.12.x: the crates and the npm packages take patch releases together.",
      matchPackageNames: ["tauri", "tauri-build", "tauri-plugin-*", "@tauri-apps/*"],
      groupName: "Tauri",
    },
    {
      matchPackageNames: ["tauri", "tauri-build", "tauri-plugin-*", "@tauri-apps/*"],
      matchUpdateTypes: ["major", "minor"],
      enabled: false,
    },
    {
      description: "React 19 and Vite 8 (spec), with the plugin and vitest majors that follow Vite's.",
      matchPackageNames: [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
        "vite",
        "@vitejs/plugin-react",
        "vitest",
      ],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      description: "Ruff is pinned in the dev group and as the ruff-pre-commit revision; both move in one merge request.",
      matchPackageNames: ["ruff", "astral-sh/ruff-pre-commit"],
      groupName: "Ruff",
    },
    {
      description: "mypy is pinned in the dev group and in the mypy hooks; all three move in one merge request.",
      matchPackageNames: ["mypy"],
      groupName: "mypy",
    },
    {
      description: "pytest is pinned in the dev group and in the mypy hooks; all three move in one merge request.",
      matchPackageNames: ["pytest"],
      groupName: "pytest",
    },
  ],
}

# Render output and local environments. Sample movies stay here and are not committed.
out/
.venv

# Phase 5 bundle products. The recipe is packaging/build-bundle.sh.
# The directory stays in the tree: tauri.windows.conf.json maps it as a
# resource, and the Windows build script rejects a missing path.
packaging/bundle/*
!packaging/bundle/.gitkeep
packaging/.cache

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.mypy_cache/

# Node and Rust
node_modules
desktop/dist/
desktop/src-tauri/target/
desktop/src-tauri/gen/

# What CI keeps in the checkout: the tools ci/windows-tools.ps1 installs, the
# caches and the reports. pytest --cov and `npm run test:ci` leave coverage
# data and reports behind locally too.
/.tools/
/.cargo/
/.uv-cache/
/.uv-python/
/.npm/
/.pre-commit-cache/
/.typst/
/.renovate/
/reports/
.coverage
.coverage.*
desktop/coverage/
desktop/reports/

# Media, caches, and logs wherever they appear
*.mp4
*.webm
*.gif
*.log
*.aux
*.dvi
media/

# Editor and OS
.DS_Store
*.swp
Thumbs.db
desktop.ini
.cursor/

# Crash dumps from MSYS and Cygwin tools
*.stackdump

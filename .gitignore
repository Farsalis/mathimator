# Render output and local environments. Sample movies stay here and are not committed.
out/
.venv
.python-version

# Phase 5 bundle products. The recipe is packaging/build-bundle.sh.
# The directory stays in the tree: tauri.windows.conf.json maps it as a
# resource, and the Windows build script rejects a missing path.
packaging/bundle/*
!packaging/bundle/.gitkeep
packaging/.cache

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.mypy_cache/

# Node and Rust
node_modules
desktop/dist/
desktop/src-tauri/target/
desktop/src-tauri/gen/

# Media, caches, and logs wherever they appear
*.mp4
*.webm
*.gif
*.log
*.aux
*.dvi
media/

# Editor and OS
.DS_Store
*.swp

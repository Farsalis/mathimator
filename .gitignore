# Render output and local environments. Sample movies stay here and are not committed.
out/
.venv

# The runtime bundle, which packaging/build-bundle.ps1 builds, by itself or
# as the first step of ci/package-windows.ps1.
# The directory stays in the tree: tauri.windows.conf.json maps it as a
# resource, and the Windows build script rejects a missing path.
packaging/bundle/*
!packaging/bundle/.gitkeep
packaging/.cache

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.mypy_cache/

# Node and Rust
node_modules
desktop/dist/
desktop/src-tauri/target/
desktop/src-tauri/gen/

# What CI leaves in the checkout: the tools ci/windows-tools.ps1 installs and
# the reports. The Typst that CONTRIBUTING.md installs with ci/install-typst.sh
# goes to .typst. pytest --cov and `npm run test:ci` leave coverage data and
# reports behind locally too.
/.tools/
/.cargo/
/.typst/
/reports/
.coverage
.coverage.*
desktop/coverage/
desktop/reports/

# Media, caches, and logs wherever they appear
*.mp4
*.webm
*.gif
*.log
*.aux
*.dvi
media/

# Editor and OS
.DS_Store
*.swp
Thumbs.db
desktop.ini
.cursor/

# Crash dumps from MSYS and Cygwin tools
*.stackdump

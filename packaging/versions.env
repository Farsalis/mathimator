# Pinned tools for packaging/build-bundle.ps1 and packaging/build-bundle.sh.
# Both scripts read this file: plain KEY=VALUE lines, no quotes or expansion.
#
# Every download is checked against its SHA-256 here, both after the download
# and when a cached copy is reused. A build stops when an asset it needs has no
# hash. The Windows hashes are those of the files the audited 2026-10-22 bundle
# was built from (TinyTeX publishes no checksums). To bump a tool, download and
# check the new asset, then change its version and hashes together.

# uv decides which python-build-standalone builds exist and checks their
# SHA-256s, so this pin also pins the bundled CPython. Keep it equal to
# required-version in pyproject.toml.
UV_VERSION=0.13.5
UV_WINDOWS_SHA256=a38b8d1902b7cfbc76b423ba1bb456f623f42064cdc72628b6075b89afd1019a
UV_LINUX_SHA256=

# The bundled interpreter. The fallback is used only when a package in uv.lock
# has no wheel for PYTHON_VERSION.
PYTHON_VERSION=3.14.9
PYTHON_FALLBACK_VERSION=3.13.17

TINYTEX_VERSION=2026.10
TINYTEX_WINDOWS_SHA256=36c329c644683d981a668419d13c8804696e2816ae4d287ad755788fee231a31
TINYTEX_LINUX_SHA256=
# tlmgr updates itself and installs the seed packages from this dated TeX Live
# 2026 snapshot, so a rebuild gets the same package revisions, and it keeps
# working after TeX Live 2027 is released.
TLNET_REPOSITORY=https://texlive.info/tlnet-archive/2026/10/23/tlnet

TYPST_VERSION=0.15.0
TYPST_WINDOWS_SHA256=66ae7f0907b4b9afed5c7d6cb9b21e07f0f3c3d4e293ba3e0026a54d88202fe9
TYPST_LINUX_SHA256=

  self.wait(_beat_time(6, 6.5, wait=True))\n        self.play(plot_1.animate.set_color(\"#FFFF00\"), run_time=_beat_time(6.5, 7))\n        self.wait(_beat_time(7, 7.5, wait=True))\n        self.play(plot_1.animate.set_color(\"#9A72AC\"), run_time=_beat_time(7.5, 8))\n        self.wait(_beat_time(8, 8.5, wait=True))\n        self.play(plot_1.animate.set_color(\"#FF862F\"), run_time=_beat_time(8.5, 9))\n        self.wait(_beat_time(9, 9.5, wait=True))\n        self.play(plot_1.animate.set_color(\"#29ABCA\"), run_time=_beat_time(9.5, 10))\n",

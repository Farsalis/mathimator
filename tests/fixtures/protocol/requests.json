{
  "placeholders": {
    "{project}": "the folder the worker was started on with --init",
    "{other}": "an empty folder beside it"
  },
  "requests": [
    {"line": {"id": "status-1", "cmd": "status"},
     "expect": [{"event": "ready", "protocol": 2, "startupError": null}]},
    {"line": {"id": "rpc-2", "cmd": "get_state"},
     "expect": [{"event": "state", "projectPath": "{project}", "derived": {"canUndo": false, "canRedo": false}}]},
    {"line": {"id": "rpc-3", "cmd": "edit", "edit": {"op": "add_formula", "afterBeatId": null}},
     "expect": [{"event": "state", "changed": true, "focus": {"beatId": "beat_1", "objectId": "formula_1"}}]},
    {"line": {"id": "rpc-4", "cmd": "edit", "edit": {"op": "set_latex", "objectId": "formula_1", "latex": "\\csname x\\endcsname"}},
     "expect": [{"event": "rejected", "code": "untrusted_latex", "field": "latex"}]},
    {"line": {"id": "rpc-5", "cmd": "edit", "edit": {"op": "add_text", "afterBeatId": null}},
     "expect": [{"event": "state", "changed": true, "focus": {"beatId": "beat_2", "objectId": "text_1"}}]},
    {"line": {"id": "rpc-6", "cmd": "edit", "edit": {"op": "set_project_name", "name": "Untitled"}},
     "expect": [{"event": "state", "changed": false}]},
    {"line": {"id": "rpc-7", "cmd": "undo"},
     "expect": [{"event": "state", "derived": {"canUndo": true, "canRedo": true}}]},
    {"line": {"id": "rpc-8", "cmd": "redo"},
     "expect": [{"event": "state", "derived": {"canUndo": true, "canRedo": false}}]},
    {"line": {"id": "rpc-9", "cmd": "code"},
     "expect": [{"event": "code"}]},
    {"line": {"id": "tex-10", "cmd": "set_tex_error", "message": null},
     "expect": []},
    {"line": {"id": "preview-11", "cmd": "render_preview"},
     "expect": [{"event": "started"}, {"event": "beat_ready", "beatIndex": 0}, {"event": "beat_ready", "beatIndex": 1},
                {"event": "done"}]},
    {"line": {"id": "export-12", "cmd": "export", "force": false},
     "expect": [{"event": "started"}, {"event": "done", "current": true}]},
    {"line": {"id": "export-13", "cmd": "export", "force": false},
     "expect": [{"event": "done", "current": true}]},
    {"line": {"id": "cancel-14", "cmd": "cancel", "jobId": "preview-999"},
     "expect": [{"event": "rejected", "code": "no_such_job"}]},
    {"line": {"id": "rpc-15", "cmd": "open_project", "path": "{project}/missing", "init": true},
     "expect": [{"event": "rejected", "code": "not_a_project"}]},
    {"line": {"id": "rpc-16", "cmd": "clear_cache"},
     "expect": [{"event": "state", "projectPath": "{project}"}]},
    {"line": {"id": "rpc-17", "cmd": "reload"},
     "expect": [{"event": "state", "derived": {"canUndo": false, "canRedo": false}}]},
    {"line": {"id": "rpc-18", "cmd": "overwrite"},
     "expect": [{"event": "state", "projectPath": "{project}"}]},
    {"line": {"cmd": "status"},
     "expect": [{"event": "error", "jobId": null, "code": "bad_request"}]},
    {"line": {"id": "rpc-19", "cmd": "save_as", "path": "{other}"},
     "expect": [{"event": "state", "projectPath": "{other}", "derived": {"canUndo": false}}]},
    {"line": {"id": "status-20", "cmd": "status"},
     "expect": [{"event": "ready", "protocol": 2, "startupError": null}]}
  ]
}
